<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Compendium framework base packages — pinned to published nuget.org versions.
       Compendium.Abstractions.VectorStore is NOT listed here: it lives in this repo
       (src/Compendium.Abstractions.VectorStore) and is consumed via ProjectReference. -->
  <ItemGroup>
    <PackageVersion Include="Compendium.Abstractions" Version="1.0.5-preview.1" />
    <PackageVersion Include="Compendium.Core" Version="1.0.5-preview.1" />
  </ItemGroup>

  <!-- Build-time tooling -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="6.0.0" />
  </ItemGroup>

  <!-- Production runtime (union of the source repos' pins; conflicts resolved to the highest).
       The Microsoft.Extensions.* family is pinned per target further down. -->
  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="9.0.4" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
  </ItemGroup>

  <!-- Test stack (matches the framework's testing conventions exactly) -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="5.1.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="RichardSzalay.MockHttp" Version="7.0.0" />
  </ItemGroup>

  <!-- Container fixtures for integration tests ([RequiresDocker]-gated) -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers" Version="4.11.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.11.0" />
  </ItemGroup>

  <!-- NET10-01: one line per target for the Microsoft.Extensions.* family, whose packages
       are versioned with the runtime.

       The net9.0 line is the 9.0.x set consumers already run against; it does not move.
       net10.0 cannot share it: packages built for .NET 10 ask for
       Microsoft.Extensions.* >= 10.0.0 in their net10.0 dependency group, and a central
       9.0.x pin would then be a package downgrade (NU1605, an error here). The conditions
       hold in the inner (per-target) builds, which are the only ones that restore
       packages; the outer build sees no TargetFramework and needs none of these. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.16" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.16" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.13" />
  </ItemGroup>
</Project>
